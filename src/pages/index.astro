---
import Layout from '../layouts/Layout.astro';
import HeroSection from "../sections/HeroSection.astro";
import ExperienceSection from "../sections/ExperienceSection.astro";
import ProjectsSection from "../sections/ProjectsSection.astro";
import AboutSection from "../sections/AboutSection.astro";
import ContactSection from "../sections/ContactSection.astro";
---

<Layout title="Daniel Hernández Alcojor - Desarrollador Full-Stack Senior">
    <main class="w-full scroll-smooth mt-16">
        <HeroSection />
        <ExperienceSection />
        <ProjectsSection />
        <AboutSection />
        <ContactSection />
    </main>
</Layout>

<style>
    main {
        section {
            @apply w-full py-8 px-4;

            > div {
                @apply lg:max-w-[1200px] h-full mx-auto flex justify-center items-center gap-4;
            }

            h2 {
                @apply text-2xl lg:text-4xl font-bold;
            }
        }

        section:nth-child(1) {
            @apply bg-gradient-to-b from-yellow-300 to-orange-400;
        }
        section:nth-child(2) {
            @apply bg-gradient-to-b from-orange-400 to-red-500;
        }
        section:nth-child(3) {
            @apply bg-gradient-to-b from-red-500 to-purple-500;
        }
        section:nth-child(4) {
            @apply bg-gradient-to-b from-purple-500 to-blue-600;
        }
        section:nth-child(5) {
            @apply bg-gradient-to-b from-blue-600 to-green-500;
        }
    }
</style>
<script>
    let sections = document.querySelectorAll('section');
    let navLinks = document.querySelectorAll('#page-navigation a');

    let observerOptions = {
        root: null, // viewport
        threshold: 0.5, // halfway through
    };

    let handleIntersection = (entries: IntersectionObserverEntry[]) => {
        navLinks.forEach((navLink) => {
            navLink.classList.remove('active');
        });
        entries.forEach((entry: IntersectionObserverEntry) => {
            // get the corresponding navigation link
            let navLink = document.querySelector(`a[href="/#${entry.target.id}"]`);

            if (entry.isIntersecting) {
                // if already in viewport, add `active` class
                navLink?.classList.add('active');
            } else {
                // if not in viewport, remove `active` class
                navLink?.classList.remove('active');
            }
        });
    };

    let observer = new IntersectionObserver(handleIntersection, observerOptions);

    // observe each section
    sections.forEach((section) => {
        observer.observe(section);
    });
</script>
