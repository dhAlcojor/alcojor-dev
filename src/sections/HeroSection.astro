---
import WizelineLogo from "../components/logos/WizelineLogo.astro";
import TypeScriptLogo from "../components/logos/TypeScriptLogo.astro";
import ReactLogo from "../components/logos/ReactLogo.astro";
import RestLogo from "../components/logos/RestLogo.astro";
import NextLogo from "../components/logos/NextLogo.astro";
import GraphQLLogo from "../components/logos/GraphQLLogo.astro";
import NodeLogo from "../components/logos/NodeLogo.astro";
import JavaScriptLogo from "../components/logos/JavaScriptLogo.astro";
---
<section id="home" class=" text-white flex flex-col justify-center items-center gap-8">
    <header class="flex flex-col lg:flex-row items-center gap-2">
        <img class="h-10 w-10 lg:h-24 lg:w-24 border-2 border-black rounded-full" src="/images/profile.webp" alt="Foto de perfil de Daniel H. Alcojor"/>
        <h2 class="text-black">
            Daniel Hernández Alcojor
            <small class="block text-purple-800">Desarrollador Full-Stack Senior</small>
        </h2>
    </header>
    <div class="lg:max-w-[67%] text-black flex flex-col gap-4">
        <p>
            Soy un desarrollador web senior, con <span id="years" class="font-mono text-2xl font-bold text-purple-800">17+</span> años de experiencia en desarrollo de aplicaciones web, móviles, y APIs.
        </p>
        <p>
            He trabajado para clientes de todo tipo de negocios: bancos, empresas de retail, medios de comunicación, etc.
        </p>
        <p>
            Actualmente trabajo como <strong>desarrollador full-stack</strong> en
        </p>
        <span class="-mt-4 text-center">
            <a class="border-b-2 border-transparent hover:border-b-2 hover:border-dashed hover:border-red-600" href="https://wizeline.com/" target="_blank" title="Página de Wizeline">
                <WizelineLogo />
            </a>
        </span>
        <p>Estas son las principales tecnologías que utilizo en mi trabajo:</p>
        <ul class="logo-list w-2/3 mx-auto lg:w-full">
            <li><RestLogo /></li>
            <li><TypeScriptLogo /></li>
            <li><JavaScriptLogo /></li>
            <li><ReactLogo /></li>
            <li><GraphQLLogo /></li>
            <li><NodeLogo /></li>
            <li><NextLogo /></li>
        </ul>
    </div>
</section>

<script>
    import {diffYears} from "@formkit/tempo";

    const years = document.getElementById('years');
    const expYears = diffYears(new Date(), new Date(2006, 7, 1));
    if (years) years.innerHTML = `${expYears}+`;
</script>
