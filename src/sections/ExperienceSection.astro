<style>
    article {
      @apply w-full text-left border-2 border-white rounded-lg p-4;

        header {
            h3 {
                @apply text-xl font-bold;
            }
            span {
                @apply text-base;

                &.company {
                    @apply block font-bold;
                }
            }
        }
    }
</style>
<script>
    import {diffMonths, format} from "@formkit/tempo";
    const $ = ( selector: string, obj?: Element) => (obj || document).querySelector(selector);
    const $$ = (selector: string, obj?: Element) => (obj || document).querySelectorAll(selector);
    const getDate = (dateString: string) => {
        const [year, month, day] = dateString.split('-').map(Number);
        return new Date(year, month - 1, day);
    }

    const articles = $$('article');
    articles.forEach((article) => {
        const startDateString = article.getAttribute('data-start-date') ?? '';
        const endDateString = article.getAttribute('data-end-date');
        const startDate = getDate(startDateString);
        const endDate = endDateString ? getDate(endDateString) : new Date();
        const totalMonths = diffMonths(endDate, startDate);
        const years = Math.floor(totalMonths / 12);
        const months = totalMonths % 12 + 1;

        const dates = $('.dates', article);
        const startDateFormatted = `${format(startDate, 'MMM')} ${format(startDate, 'YYYY')}`;
        const endDateFormatted = endDateString ? `${format(endDate, 'MMM')} ${format(endDate, 'YYYY')}` : 'Actualidad';
        const yearsFormatted = years > 0 ? `${years} A` : undefined;
        const monthsFormatted = months > 0 ? `${months} M` : undefined;
        const timeFormatted = yearsFormatted && monthsFormatted ? `${yearsFormatted}, ${monthsFormatted}` : yearsFormatted || monthsFormatted;
        if (dates) dates.innerHTML = `${startDateFormatted} - ${endDateFormatted} (${timeFormatted})`;
    })
</script>
